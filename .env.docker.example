# Archivo de variables de entorno para Docker
# Copia este archivo a .env.docker para personalizar la configuración

# Base de Datos MySQL
MYSQL_DATABASE=clinica
MYSQL_ROOT_PASSWORD=root2025

# Puertos de la aplicación
NGINX_PORT=80
MYSQL_PORT=3306

# Red Docker
DOCKER_NETWORK=clinica_network

# Nombre del proyecto (prefijo para contenedores)
COMPOSE_PROJECT_NAME=clinica
